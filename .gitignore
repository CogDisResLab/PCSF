# -----------------------------
# R / RStudio
# -----------------------------
# RStudio project-local settings and session metadata.
.Rproj.user

# Interactive history/state files generated during local sessions.
.Rhistory
.Rapp.history
.RData
.Ruserdata

# Package build/check artifacts
# Created by `R CMD check` (including devtools/check wrappers).
*.Rcheck/
*/*.Rcheck/

# Source package bundles generated by `R CMD build`.
*.tar.gz

# knitr / rmarkdown outputs
# Intermediate markdown outputs from knitting workflows.
*.utf8.md
*.knit.md

# renv local library/cache (keep lockfile and settings tracked)
# Machine-specific package installs and temporary staging dirs.
# Note: keep `renv.lock` and `renv/settings.json` versioned.
renv/library/
renv/local/
renv/staging/

# -----------------------------
# C / C++ build artifacts
# -----------------------------
# Common artifacts emitted directly under src/ during R package compilation.
src/*.o
src/*.so
src/*.dll
src/*.dylib
src/*.a
src/*.obj
src/*.lib
src/*.exe

# Generic native build outputs (any directory).
*.o
*.obj
*.a
*.so
*.dll
*.dylib
*.lib

# Linker/debug byproducts (mostly MSVC toolchain).
*.exp
*.pdb
*.idb
*.ilk

# Build-system generated files.
*.mod
*.cmake
cmake-build-*/
CMakeFiles/
CMakeCache.txt

# Optional compilation database generated by CMake tooling.
compile_commands.json

# -----------------------------
# Operating system files
# -----------------------------
# macOS
# Finder and filesystem metadata.
.DS_Store
.AppleDouble
.LSOverride
._*
.Spotlight-V100
.Trashes

# Windows
# Explorer and recycle bin metadata.
Thumbs.db
Desktop.ini
$RECYCLE.BIN/

# Linux / generic temp files
# Editor backups and swap files.
*~
*.swp
*.swo

# Editors / IDEs
# VS Code workspace-local settings.
.vscode/

# LLM Related files
.codegraph/

# Log files
*.log
